<h1>Play Game</h1>
<div><%= @game.rated %></div>
<div><%= @game.time_base %></div>
<div><%= @game.time_increment %></div>

<div class="chessboard" >
  <% 8.times do |i|%>
    <div class="row">
      <% 8.times do |j|%>
        <div class="<%= (i % 2) == (j % 2) ? "white" : "black" %>  field" >
          <% field_number = 20 + (i * 10) + j + 1 %>
          <% if @position.board[field_number] != nil && @position.board[field_number] != :border %>
          <% if @position.board[field_number] != nil && @position.board[field_number] != :border %>
            <%= link_to @position.board[field_number].symbol, possible_moves_game_path(@game, field: field_number), data: {turbo_action: "replace"} %>
          <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <% console %>
</div>
