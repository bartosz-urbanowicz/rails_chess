<%= turbo_stream_from "game_#{@game.id}" %>
<%= "game_#{@game.id}" %>

<h1>Play Game</h1>
<div><%= @game.rated %></div>
<div><%= @game.time_base %></div>
<div><%= @game.time_increment %></div>


<%= render partial: "games/chessboard",
 locals: { game: @game,
  position: @position,
  possible_moves: @possible_moves,
  field: @field,
  player_color: @player_color 
} %>
<div>
  <div>White: <%= @white_player.username %></div>
  <div>Black: <%= @black_player.username %></div>
</div>
<% console %>