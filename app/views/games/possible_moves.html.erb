<h1>Play Game</h1>
<div><%= @game.rated %></div>
<div><%= @game.time_base %></div>
<div><%= @game.time_increment %></div>

<div class="flex flex-col" >
  <% 8.times do |i|%>
    <div class="flex">
      <% 8.times do |j|%>
        <div 
          class="
            <%= (i % 2) == (j % 2) ? 
              "bg-stone-200 text-black" : 
              "bg-stone-900 text-white" 
            %> w-[4em] h-[4em] flex justify-center items-center" >
          <% field_number = 20 + (i * 10) + j + 1 %>
          <% if @position.board[field_number] != nil && @position.board[field_number] != :border %>
            <%= link_to @position.board[field_number].symbol, possible_moves_game_path(@game, field: field_number) %>
          <% end %>
          <% if @possible_moves.map(&:end_field).include? field_number %>
            <div class="bg-gray-500 w-4 h-4 rounded-full"></div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <% console %>
</div>
